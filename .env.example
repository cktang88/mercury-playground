# Copy to .env and set ONE of these keys.
# If both are set, Inception is used.

# Direct from Inception: https://platform.inceptionlabs.ai/dashboard/api-keys
INCEPTION_API_KEY=

# Or via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
# INCEPTION_API_URL=https://api.inceptionlabs.ai/v1/chat/completions
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# PORT=3000

# Optional settings (see config.js and the README's Configuration section)
# PANE_MODELS=mercury-3,mercury-2.5
# INCEPTION_REASONING_EFFORTS=instant,low,medium,high
# INCEPTION_DEFAULT_EFFORT=
# OPENROUTER_REASONING_EFFORTS=none,low,medium,high
# OPENROUTER_DEFAULT_EFFORT=
# OPENROUTER_WEB_SEARCH=true
# OPENROUTER_WEB_SEARCH_ENGINE=exa
# OPENROUTER_WEB_SEARCH_MODE=instant
# OPENROUTER_WEB_SEARCH_MAX_RESULTS=5
