# Copy to .env and set ONE of these keys.
# If both are set, Inception is used.

# Direct from Inception: https://platform.inceptionlabs.ai/dashboard/api-keys
INCEPTION_API_KEY=

# Or via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
# INCEPTION_API_URL=https://api.inceptionlabs.ai/v1/chat/completions
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# PORT=3000
